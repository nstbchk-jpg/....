SET NOCOUNT ON;
IF OBJECT_ID('tempdb..#hits') IS NOT NULL DROP TABLE #hits;
CREATE TABLE #hits (loc NVARCHAR(400), hits INT);

DECLARE @sql NVARCHAR(MAX)=N'';
SELECT @sql = @sql +
 'INSERT INTO #hits SELECT '''+sc.name+'.'+t.name+'.'+c.name+''','+
 'COUNT(*) FROM '+QUOTENAME(sc.name)+'.'+QUOTENAME(t.name)+
 ' WHERE '+QUOTENAME(c.name)+' LIKE N''%SOC%'';'+CHAR(10)
FROM sys.columns c
JOIN sys.tables t   ON c.object_id=t.object_id
JOIN sys.schemas sc ON t.schema_id=sc.schema_id
JOIN sys.types ty   ON c.user_type_id=ty.user_type_id
WHERE ty.name IN('varchar','nvarchar','char','nchar','text','ntext');

EXEC sp_executesql @sql;
SELECT * FROM #hits WHERE hits > 0 ORDER BY hits DESC;
