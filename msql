SELECT 'SELECT * FROM (' + STUFF((
  SELECT ' UNION ALL SELECT '''+sc.name+'.'+t.name+'.'+c.name+''' AS loc, COUNT(*) AS hits FROM '
         +QUOTENAME(sc.name)+'.'+QUOTENAME(t.name)+' WHERE '+QUOTENAME(c.name)+' LIKE N''%ТВІЙ_ХЕШ%'''
  FROM sys.columns c
  JOIN sys.tables t   ON c.object_id=t.object_id
  JOIN sys.schemas sc ON t.schema_id=sc.schema_id
  JOIN sys.types ty   ON c.user_type_id=ty.user_type_id
  WHERE ty.name IN('varchar','nvarchar','text','ntext')
    AND (c.max_length = -1 OR c.max_length >= 200)
  FOR XML PATH(''),TYPE).value('.','NVARCHAR(MAX)'),1,11,'')
  + ') q WHERE hits > 0;' AS run_me;
