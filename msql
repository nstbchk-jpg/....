SELECT (
 SELECT 'IF EXISTS(SELECT 1 FROM '+QUOTENAME(sc.name)+'.'+QUOTENAME(t.name)+
        ' WHERE '+QUOTENAME(c.name)+' LIKE N''%SOC Test%'') PRINT '''+
        sc.name+'.'+t.name+' -> '+c.name+''';' + CHAR(13)+CHAR(10)
 FROM sys.columns c
 JOIN sys.tables t   ON c.object_id=t.object_id
 JOIN sys.schemas sc ON t.schema_id=sc.schema_id
 JOIN sys.types ty   ON c.user_type_id=ty.user_type_id
 WHERE ty.name IN('varchar','nvarchar','char','nchar','text','ntext')
 FOR XML PATH(''), TYPE
).value('.','NVARCHAR(MAX)') AS run_me;
